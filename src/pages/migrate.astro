---
// src/pages/migrate.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import MigrationClaim from '../islands/MigrationClaim';
import { flattenTranslations } from '../i18n/index';
import { db } from '../db';
import { legacyMappings, users } from '../db/schema';
import { eq } from 'drizzle-orm';
import { requireAuth } from '../lib/guards';

const t = Astro.locals.t;
const guard = requireAuth(Astro);
if (guard instanceof Response) return guard;
const currentUser = guard;

// Check if user already migrated
const [existingMigration] = await db.select().from(legacyMappings)
  .where(eq(legacyMappings.realUserId, currentUser.id))
  .limit(1);

const translations = flattenTranslations(Astro.locals.translations as unknown as Record<string, unknown>);
const isNewUser = Astro.url.searchParams.get('new') === '1';
const verifyToken = Astro.url.searchParams.get('verify') || undefined;

// Mark migration prompt as seen
if (currentUser && !currentUser.seenMigrationPrompt) {
  await db.update(users).set({ seenMigrationPrompt: true }).where(eq(users.id, currentUser.id));
}
---

<BaseLayout title={t('migration.title')}>
  <div class="space-y-6">
    <a href="/profile/edit" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      {t('common.back')}
    </a>

    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">{t('migration.title')}</h1>
    <p class="text-gray-600 dark:text-gray-400">{t('migration.description')}</p>

    {isNewUser && (
      <div class="bg-blue-50 dark:bg-blue-900/30 border border-blue-200 dark:border-blue-800 rounded-lg p-4">
        <p class="text-blue-700 dark:text-blue-300 font-medium">{t('migration.welcomeNew')}</p>
        <p class="text-blue-600 dark:text-blue-400 text-sm mt-1">{t('migration.welcomeNewDesc')}</p>
      </div>
    )}

    {existingMigration ? (
      <div class="bg-green-50 dark:bg-green-900/30 border border-green-200 dark:border-green-800 rounded-lg p-4">
        <p class="text-green-700 dark:text-green-300 font-medium">{t('migration.alreadyMigrated')}</p>
      </div>
    ) : (
      <MigrationClaim client:load t={translations} isNewUser={isNewUser} verifyToken={verifyToken} />
    )}
  </div>
</BaseLayout>
