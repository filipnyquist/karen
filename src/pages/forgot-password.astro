---
// src/pages/forgot-password.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { config } from '../config';
import { sha256ScriptHash } from '../lib/csp';

const t = Astro.locals.t;
const user = Astro.locals.user;

// No redirect-if-logged-in: a logged-in user reaching /forgot-password
// is fine; the link from the login page is the primary entry.

const error = Astro.url.searchParams.get('error');
const msg = Astro.url.searchParams.get('msg');
const turnstileSitekey = config.turnstile.sitekey;

// See login.astro for the rationale on not pinning SRI here.
if (turnstileSitekey) {
    Astro.csp?.insertScriptResource("https://challenges.cloudflare.com");
}

// Inline submit handler. Same shape as login/register — the literal
// string rendered into the HTML must match the hash we register.
const forgotScript = `(function(){
  const turnstileSitekey = ${JSON.stringify(turnstileSitekey)};
  document.getElementById('forgot-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const body = { email: form.email.value };
    if (turnstileSitekey && window.turnstile) {
      const token = turnstile.getResponse();
      if (!token) return;
      body.turnstileToken = token;
    }
    try {
      const res = await fetch('/api/auth/forgot-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
        credentials: 'same-origin',
      });
      // Same success page whether or not the email exists. The
      // service never tells; the user always sees the "check your
      // inbox" banner.
      if (res.ok) {
        window.location.href = '/forgot-password?msg=sent';
      } else {
        const err = await res.json();
        window.location.href = '/forgot-password?error=' + encodeURIComponent(err.error || 'Request failed');
      }
    } catch {
      window.location.href = '/forgot-password?error=Network error';
    }
  });
})();`;

Astro.csp?.insertScriptHash(sha256ScriptHash(forgotScript));
---

<BaseLayout title={t('auth.forgotPassword.title')}>
  <div class="max-w-md mx-auto">
    <div class="bg-white dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-800 p-6 sm:p-8">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">
        {t('auth.forgotPassword.title')}
      </h1>
      <p class="text-sm text-gray-600 dark:text-gray-400 mb-6">
        {t('auth.forgotPassword.description')}
      </p>

      {error && (
        <div class="mb-4 p-3 rounded-md bg-red-50 dark:bg-red-950 border border-red-200 dark:border-red-800">
          <p class="text-sm text-red-700 dark:text-red-300">{error}</p>
        </div>
      )}

      {msg === 'sent' && (
        <div class="mb-4 p-3 rounded-md bg-green-50 dark:bg-green-950 border border-green-200 dark:border-green-800">
          <p class="text-sm text-green-700 dark:text-green-300">
            {t('auth.forgotPassword.success')}
          </p>
        </div>
      )}

      <form id="forgot-form" method="post" action="/forgot-password" class="space-y-4">
        <div>
          <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            {t('auth.forgotPassword.emailLabel')}
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            class="w-full px-3 py-2 rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            placeholder="name@example.com"
          />
        </div>

        {turnstileSitekey && (
          <div class="cf-turnstile flex justify-center" data-sitekey={turnstileSitekey}></div>
        )}

        <button
          type="submit"
          class="w-full px-4 py-2 rounded-md bg-blue-600 text-white font-medium hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900 transition-colors"
        >
          {t('auth.forgotPassword.submitButton')}
        </button>
      </form>

      {turnstileSitekey && (
        <script
          src="https://challenges.cloudflare.com/turnstile/v0/api.js"
          async
          defer
        ></script>
      )}

      <script is:inline set:html={forgotScript}></script>

      <p class="mt-4 text-center text-sm text-gray-600 dark:text-gray-400">
        <a href="/login" class="text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 font-medium">
          {t('auth.forgotPassword.backToLogin')}
        </a>
      </p>
    </div>
  </div>
</BaseLayout>