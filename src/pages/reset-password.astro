---
// src/pages/reset-password.astro
//
// Self-service password-reset page. SSR pre-flight checks the
// token via /api/auth/reset-password/check, then renders the
// password form (or one of three banner states: invalid / expired
// / used). Submission posts JSON to /api/auth/reset-password,
// then redirects to /login?msg=password-reset.

import BaseLayout from '../layouts/BaseLayout.astro';
import { sha256ScriptHash } from '../lib/csp';

const t = Astro.locals.t;
const token = Astro.url.searchParams.get('token') ?? '';
const error = Astro.url.searchParams.get('error');
const msg = Astro.url.searchParams.get('msg');

// SSR fetch: validate the token via the API so we render the right
// banner. We hit the INTERNAL_URL (defaults to localhost:4321) rather
// than `config.baseUrl` because config.baseUrl is the PUBLIC URL
// (e.g. http://localhost:4322 in the e2e container, where the
// docker port-mapping makes 4322 reachable from the browser but not
// from inside the container). The token never leaves the container,
// so the public URL isn't relevant for an internal pre-flight.
// Override via SSR_BASE_URL env if the server listens on a
// different internal port.
type ValidityResult =
    | { valid: true }
    | { valid: false; reason: "invalid" | "expired" | "used" };
let validity: ValidityResult | null = null;

if (token) {
    const internalBaseUrl =
        process.env.SSR_BASE_URL ?? "http://localhost:4321";
    try {
        const checkUrl = `${internalBaseUrl}/api/auth/reset-password/check?token=${encodeURIComponent(token)}`;
        const res = await fetch(checkUrl);
        if (res.ok) {
            validity = (await res.json()) as ValidityResult;
        } else {
            validity = { valid: false, reason: "invalid" };
        }
    } catch {
        validity = { valid: false, reason: "invalid" };
    }
} else {
    validity = { valid: false, reason: "invalid" };
}

// Inline submit handler: client-side strong-password check.
// The literal string rendered into the HTML must match the hash
// we register, so we keep it in a single const.
const resetScript = `(function(){
  const weakMessage = ${JSON.stringify(t('auth.resetPassword.passwordHelp'))};
  function isStrong(value) {
    if (!value || value.length < 8) return false;
    let hasUpper = false, hasLower = false, hasDigit = false;
    for (const ch of value) {
      if (ch >= 'A' && ch <= 'Z') hasUpper = true;
      else if (ch >= 'a' && ch <= 'z') hasLower = true;
      else if (ch >= '0' && ch <= '9') hasDigit = true;
    }
    return hasUpper && hasLower && hasDigit;
  }
  document.getElementById('reset-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const password = form.password.value;
    const confirm = form.confirm.value;
    if (!isStrong(password)) {
      window.location.href = '/reset-password?token=' + encodeURIComponent(form.token.value) + '&error=' + encodeURIComponent(weakMessage);
      return;
    }
    if (password !== confirm) {
      window.location.href = '/reset-password?token=' + encodeURIComponent(form.token.value) + '&error=Passwords do not match';
      return;
    }
    try {
      const res = await fetch('/api/auth/reset-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token: form.token.value, password }),
        credentials: 'same-origin',
      });
      if (res.ok) {
        window.location.href = '/login?msg=password-reset';
      } else {
        const err = await res.json();
        window.location.href = '/reset-password?token=' + encodeURIComponent(form.token.value) + '&error=' + encodeURIComponent(err.error || 'Reset failed');
      }
    } catch {
      window.location.href = '/reset-password?token=' + encodeURIComponent(form.token.value) + '&error=Network error';
    }
  });
})();`;

Astro.csp?.insertScriptHash(sha256ScriptHash(resetScript));
---

<BaseLayout title={t('auth.resetPassword.title')}>
  <div class="max-w-md mx-auto">
    <div class="bg-white dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-800 p-6 sm:p-8">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">
        {t('auth.resetPassword.title')}
      </h1>

      {msg === 'password-reset' && (
        <div class="mb-4 p-3 rounded-md bg-green-50 dark:bg-green-950 border border-green-200 dark:border-green-800">
          <p class="text-sm text-green-700 dark:text-green-300">
            {t('auth.resetPassword.successMessage')}
          </p>
        </div>
      )}

      {validity && !validity.valid && (
        <div class="mb-4 p-3 rounded-md bg-red-50 dark:bg-red-950 border border-red-200 dark:border-red-800">
          <p class="text-sm text-red-700 dark:text-red-300">
            {validity.reason === "expired"
              ? t('auth.resetPassword.expiredToken')
              : validity.reason === "used"
                ? t('auth.resetPassword.usedToken')
                : t('auth.resetPassword.invalidToken')}
          </p>
        </div>
      )}

      {validity && validity.valid && (
        <form id="reset-form" method="post" action="/reset-password" class="space-y-4">
          {error && (
            <div class="p-3 rounded-md bg-red-50 dark:bg-red-950 border border-red-200 dark:border-red-800">
              <p class="text-sm text-red-700 dark:text-red-300">{error}</p>
            </div>
          )}

          <input type="hidden" name="token" value={token} />

          <div>
            <label for="password" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
              {t('auth.resetPassword.passwordLabel')}
            </label>
            <input
              type="password"
              id="password"
              name="password"
              required
              autocomplete="new-password"
              minlength="8"
              class="w-full px-3 py-2 rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
              {t('auth.resetPassword.passwordHelp')}
            </p>
          </div>

          <div>
            <label for="confirm" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
              {t('auth.resetPassword.passwordLabel')}
            </label>
            <input
              type="password"
              id="confirm"
              name="confirm"
              required
              autocomplete="new-password"
              minlength="8"
              class="w-full px-3 py-2 rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
          </div>

          <button
            type="submit"
            class="w-full px-4 py-2 rounded-md bg-blue-600 text-white font-medium hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900 transition-colors"
          >
            {t('auth.resetPassword.submitButton')}
          </button>
        </form>
      )}

      <script is:inline set:html={resetScript}></script>

      <p class="mt-4 text-center text-sm text-gray-600 dark:text-gray-400">
        <a href="/login" class="text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 font-medium">
          {t('auth.resetPassword.loginPrompt')}
        </a>
      </p>
    </div>
  </div>
</BaseLayout>