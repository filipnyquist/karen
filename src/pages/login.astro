---
// src/pages/login.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { config } from '../config';
import { sha256ScriptHash } from '../lib/csp';

const t = Astro.locals.t;
const user = Astro.locals.user;

// Redirect if already logged in
if (user) {
  return Astro.redirect('/');
}

const error = Astro.url.searchParams.get('error');
const verified = Astro.url.searchParams.get('verified');
const msg = Astro.url.searchParams.get('msg');
const turnstileSitekey = config.turnstile.sitekey;

// Note: Turnstile's api.js URL is not versioned — Cloudflare updates the
// bytes in place. SRI on this script would silently break login on every
// Cloudflare push, so we rely on CSP `script-src` (set in astro.config.mjs)
// + `insertScriptResource` below as the security boundary instead.
if (turnstileSitekey) {
    Astro.csp?.insertScriptResource("https://challenges.cloudflare.com");
}

// Inline submit handler. The literal string rendered into the HTML must
// match the hash we register, so we keep it in a single const.
const loginScript = `(function(){
  const turnstileSitekey = ${JSON.stringify(turnstileSitekey)};
  document.getElementById('login-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const email = form.email.value;
    const password = form.password.value;

    const body = { email, password };
    if (turnstileSitekey && window.turnstile) {
      const token = turnstile.getResponse();
      if (!token) return;
      body.turnstileToken = token;
    }

    try {
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
        credentials: 'same-origin',
      });
      if (res.ok) {
        window.location.href = '/';
      } else {
        const err = await res.json();
        const params = new URLSearchParams({ error: err.error || 'Login failed' });
        window.location.href = '/login?' + params;
      }
    } catch {
      window.location.href = '/login?error=Network error';
    }
  });
})();`;

Astro.csp?.insertScriptHash(sha256ScriptHash(loginScript));
---

<BaseLayout title={t('auth.login')}>
  <div class="max-w-md mx-auto">
    <div class="bg-white dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-800 p-6 sm:p-8">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">
        {t('auth.login')}
      </h1>

      {error && (
        <div class="mb-4 p-3 rounded-md bg-red-50 dark:bg-red-950 border border-red-200 dark:border-red-800">
          <p class="text-sm text-red-700 dark:text-red-300">{error}</p>
        </div>
      )}

      {verified && (
        <div class="mb-4 p-3 rounded-md bg-green-50 dark:bg-green-950 border border-green-200 dark:border-green-800">
          <p class="text-sm text-green-700 dark:text-green-300">{t('auth.emailVerified')}</p>
        </div>
      )}

      {msg === 'registered' && (
        <div class="mb-4 p-3 rounded-md bg-green-50 dark:bg-green-950 border border-green-200 dark:border-green-800">
          <p class="text-sm text-green-700 dark:text-green-300">{t('auth.verifyEmail')}</p>
        </div>
      )}

      {msg === 'password-reset' && (
        <div class="mb-4 p-3 rounded-md bg-green-50 dark:bg-green-950 border border-green-200 dark:border-green-800">
          <p class="text-sm text-green-700 dark:text-green-300">
            {t('auth.resetPassword.successMessage')}
          </p>
        </div>
      )}

      <div class="mb-4 p-3 rounded-md bg-blue-50 dark:bg-blue-950 border border-blue-200 dark:border-blue-800">
        <p class="text-sm text-blue-700 dark:text-blue-300">
          {t('auth.legacyAccountNotice')}
        </p>
      </div>

      <form id="login-form" method="post" action="/login" data-sitekey={turnstileSitekey} class="space-y-4">
        <div>
          <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            {t('auth.email')}
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            class="w-full px-3 py-2 rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            placeholder="name@example.com"
          />
        </div>

        <div>
          <label for="password" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            {t('auth.password')}
          </label>
          <input
            type="password"
            id="password"
            name="password"
            required
            autocomplete="current-password"
            class="w-full px-3 py-2 rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          />
        </div>

        {turnstileSitekey && (
          <div class="cf-turnstile flex justify-center" data-sitekey={turnstileSitekey}></div>
        )}

        <button
          type="submit"
          class="w-full px-4 py-2 rounded-md bg-blue-600 text-white font-medium hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900 transition-colors"
        >
          {t('auth.loginButton')}
        </button>
      </form>

      <p class="mt-4 text-center text-sm text-gray-600 dark:text-gray-400">
        <a
          href="/forgot-password"
          class="text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 font-medium"
        >
          {t('auth.forgotPasswordLink')}
        </a>
      </p>

      {turnstileSitekey && (
        <script
          src="https://challenges.cloudflare.com/turnstile/v0/api.js"
          async
          defer
        ></script>
      )}

      <script is:inline set:html={loginScript}></script>

      <p class="mt-4 text-center text-sm text-gray-600 dark:text-gray-400">
        {t('auth.noAccount')}
        <a href="/register" class="text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 font-medium">
          {t('auth.register')}
        </a>
      </p>
    </div>
  </div>
</BaseLayout>
