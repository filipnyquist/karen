---
// src/pages/event/edit/[id].astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EventForm from '../../../islands/EventForm';
import { flattenTranslations } from '../../../i18n/index';
import { db } from '../../../db';
import { events } from '../../../db/schema';
import { eq } from 'drizzle-orm';
import { requireAdmin } from '../../../lib/guards';

const t = Astro.locals.t;
const guard = requireAdmin(Astro);
if (guard instanceof Response) return guard;
const currentUser = guard;
const eventId = Astro.params.id!;

const [event] = await db.select().from(events).where(eq(events.id, eventId)).limit(1);
if (!event) {
  return Astro.redirect('/event/list');
}

const translations = flattenTranslations(Astro.locals.translations as unknown as Record<string, unknown>);
---

<BaseLayout title={t('event.editEvent')}>
  <div class="space-y-6">
    <a href={`/event/${eventId}`} class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      {t('common.back')}
    </a>

    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">{t('event.editEvent')}</h1>

    <EventForm eventId={eventId} client:load t={translations} />
  </div>
</BaseLayout>
