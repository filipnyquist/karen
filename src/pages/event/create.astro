---
// src/pages/event/create.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventForm from '../../islands/EventForm';
import { flattenTranslations } from '../../i18n/index';
import { requireAdmin } from '../../lib/guards';

const t = Astro.locals.t;
const guard = requireAdmin(Astro);
if (guard instanceof Response) return guard;
const currentUser = guard;

const translations = flattenTranslations(Astro.locals.translations as unknown as Record<string, unknown>);
---

<BaseLayout title={t('event.createEvent')}>
  <div class="space-y-6">
    <a href="/event/list" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      {t('common.back')}
    </a>

    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">{t('event.createEvent')}</h1>

    <EventForm client:load t={translations} />
  </div>
</BaseLayout>
