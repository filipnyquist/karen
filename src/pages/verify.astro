---
// src/pages/verify.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import StudentVerify from '../islands/StudentVerify';
import { flattenTranslations } from '../i18n/index';

const t = Astro.locals.t;
const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/login');
}

const translations = flattenTranslations(Astro.locals.translations as unknown as Record<string, unknown>);
const alreadyVerified = user.verified;
const verifiedSuccess = Astro.url.searchParams.get('verified') === '1';
---

<BaseLayout title={t('auth.verifyStudent')}>
  <div class="space-y-6">
    <a href="/" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      {t('common.back')}
    </a>

    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">{t('auth.verifyStudent')}</h1>
    <p class="text-gray-600 dark:text-gray-400">{t('auth.verifyStudentDesc')}</p>

    {alreadyVerified && !verifiedSuccess && (
      <div class="bg-green-50 dark:bg-green-900/30 border border-green-200 dark:border-green-800 rounded-lg p-4">
        <p class="text-green-700 dark:text-green-300 font-medium">{t('auth.alreadyVerified')}</p>
      </div>
    )}

    {!alreadyVerified && (
      <StudentVerify
        client:load
        t={translations}
        alreadyVerified={false}
        verifiedSuccess={verifiedSuccess}
      />
    )}

    {verifiedSuccess && alreadyVerified && (
      <div class="bg-green-50 dark:bg-green-900/30 border border-green-200 dark:border-green-800 rounded-lg p-4">
        <p class="text-green-700 dark:text-green-300 font-medium">{t('auth.verifyComplete')}</p>
      </div>
    )}
  </div>
</BaseLayout>
