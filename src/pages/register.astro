---
// src/pages/register.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { config } from '../config';
import { sha256ScriptHash } from '../lib/csp';

const t = Astro.locals.t;
const user = Astro.locals.user;

// Redirect if already logged in
if (user) {
  return Astro.redirect('/');
}

const error = Astro.url.searchParams.get('error');
const verified = Astro.url.searchParams.get('verified');
const turnstileSitekey = config.turnstile.sitekey;

// See login.astro for the rationale on not pinning SRI here.
if (turnstileSitekey) {
    Astro.csp?.insertScriptResource("https://challenges.cloudflare.com");
}

// Inline submit handler. The literal string rendered into the HTML must
// match the hash we register, so we keep it in a single const.
const registerScript = `(function(){
  const turnstileSitekey = ${JSON.stringify(turnstileSitekey)};
  const bthEmailBlocked = ${JSON.stringify(t('auth.bthEmailBlocked'))};
  const errorMessages = {
    BTH_BLOCKED: ${JSON.stringify(t('auth.bthEmailBlocked'))},
    BAD_REQUEST: ${JSON.stringify(t('auth.registerFailed') || 'Registration failed')},
    CONFLICT: ${JSON.stringify(t('auth.emailTaken') || 'Email already registered')}
  };
  document.getElementById('register-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const email = form.email.value.trim().toLowerCase();
    if (email.endsWith('@student.bth.se') || email.endsWith('@bthstudent.se')) {
      const params = new URLSearchParams({ error: bthEmailBlocked });
      window.location.href = '/register?' + params;
      return;
    }
    const body = {
      email: form.email.value,
      password: form.password.value,
      name: form.name.value,
      nickname: form.nickname.value,
    };

    if (turnstileSitekey && window.turnstile) {
      const token = turnstile.getResponse();
      if (!token) return;
      body.turnstileToken = token;
    }

    try {
      const res = await fetch('/api/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
        credentials: 'same-origin',
      });
      if (res.ok) {
        window.location.href = '/login?msg=registered';
      } else {
        const err = await res.json();
        const msg = err.code === 'BTH_BLOCKED' ? errorMessages.BTH_BLOCKED
          : err.code === 'CONFLICT' ? errorMessages.CONFLICT
          : err.error || errorMessages.BAD_REQUEST;
        const params = new URLSearchParams({ error: msg });
        window.location.href = '/register?' + params;
      }
    } catch {
      window.location.href = '/register?error=Network error';
    }
  });
})();`;

Astro.csp?.insertScriptHash(sha256ScriptHash(registerScript));
---

<BaseLayout title={t('auth.register')}>
  <div class="max-w-md mx-auto">
    <div class="bg-white dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-800 p-6 sm:p-8">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">
        {t('auth.register')}
      </h1>

      {error && (
        <div class="mb-4 p-3 rounded-md bg-red-50 dark:bg-red-950 border border-red-200 dark:border-red-800">
          <p class="text-sm text-red-700 dark:text-red-300">{error}</p>
        </div>
      )}

      {verified && (
        <div class="mb-4 p-3 rounded-md bg-green-50 dark:bg-green-950 border border-green-200 dark:border-green-800">
          <p class="text-sm text-green-700 dark:text-green-300">{t('auth.emailVerified')}</p>
        </div>
      )}

      <form id="register-form" method="post" action="/register" class="space-y-4">
        <div>
          <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            {t('auth.email')}
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            class="w-full px-3 py-2 rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            placeholder="name@example.com"
          />
        </div>

        <div>
          <label for="name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            {t('auth.name')}
          </label>
          <input
            type="text"
            id="name"
            name="name"
            autocomplete="name"
            class="w-full px-3 py-2 rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          />
        </div>

        <div>
          <label for="nickname" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            {t('auth.nickname')}
          </label>
          <input
            type="text"
            id="nickname"
            name="nickname"
            class="w-full px-3 py-2 rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          />
        </div>

        <div>
          <label for="password" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            {t('auth.password')}
          </label>
          <input
            type="password"
            id="password"
            name="password"
            required
            autocomplete="new-password"
            minlength="8"
            class="w-full px-3 py-2 rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          />
        </div>

        {turnstileSitekey && (
          <div class="cf-turnstile flex justify-center" data-sitekey={turnstileSitekey}></div>
        )}

        <button
          type="submit"
          class="w-full px-4 py-2 rounded-md bg-blue-600 text-white font-medium hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900 transition-colors"
        >
          {t('auth.registerButton')}
        </button>
      </form>

      {turnstileSitekey && (
        <script
          src="https://challenges.cloudflare.com/turnstile/v0/api.js"
          async
          defer
        ></script>
      )}

      <script is:inline set:html={registerScript}></script>

      <p class="mt-4 text-center text-sm text-gray-600 dark:text-gray-400">
        {t('auth.hasAccount')}
        <a href="/login" class="text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 font-medium">
          {t('auth.login')}
        </a>
      </p>
    </div>
  </div>
</BaseLayout>
