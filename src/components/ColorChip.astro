---
// src/components/ColorChip.astro
//
// A small colored circle used to represent team color.
//
// The color value is rendered as a class name (see `teamColorClass`),
// not as an inline `style=""` attribute — the project's CSP blocks
// inline style attributes without 'unsafe-hashes'. Parent pages that
// use this component are responsible for emitting a `<style>` block
// defining the class (see `teamColorStyleContent`).

import { sanitizeTeamColor, teamColorClass } from "../lib/teamColor";

interface Props {
    color: string | null;
    size?: "xs" | "sm" | "md";
    class?: string;
}

const { color, size = "sm", class: className = "" } = Astro.props;

const sizeClasses = {
    xs: "w-2 h-2",
    sm: "w-3 h-3",
    md: "w-4 h-4",
}[size];

const sanitized = sanitizeTeamColor(color);
---

{sanitized ? (
    <span
        class:list={[
            "rounded-full inline-block shrink-0",
            teamColorClass(sanitized),
            sizeClasses,
            className,
        ]}
        aria-hidden="true"
    />
) : (
    <span
        class:list={[
            "rounded-full inline-block shrink-0 bg-gray-300 dark:bg-gray-600",
            sizeClasses,
            className,
        ]}
        aria-hidden="true"
    />
)}