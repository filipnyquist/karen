---
// src/layouts/BaseLayout.astro
import NavBar from '../components/NavBar.astro';
import '../styles/global.css';
import { sha256ScriptHash } from '../lib/csp';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const lang = Astro.locals.lang ?? 'sv';
const t = Astro.locals.t;
const user = Astro.locals.user;
const siteTitle = title ? `${title} | ${t('site.title')}` : t('site.title');
const modalOk = t('modal.ok');
const modalCancel = t('modal.cancel');
const modalConfirm = t('modal.confirm');

// Inline modal+CSRF script. The browser CSP hashes the *exact* source string
// that ends up in the HTML, so we must render the script via `set:html` with
// the same string we hash, and not introduce any whitespace mutations between
// the two.
const layoutScript = `(function(){
  const modalOk = ${JSON.stringify(modalOk)};
  const modalCancel = ${JSON.stringify(modalCancel)};
  const modalConfirm = ${JSON.stringify(modalConfirm)};
  const modal = document.getElementById('app-modal');
  const msgEl = document.getElementById('app-modal-message');
  const okBtn = document.getElementById('app-modal-ok');
  const cancelBtn = document.getElementById('app-modal-cancel');
  const confirmBtn = document.getElementById('app-modal-confirm');

  function showModal() {
    modal.classList.remove('hidden');
    okBtn.classList.add('hidden');
    cancelBtn.classList.add('hidden');
    confirmBtn.classList.add('hidden');
  }
  function hideModal() {
    modal.classList.add('hidden');
  }

  window.appAlert = function(message) {
    msgEl.textContent = message;
    showModal();
    okBtn.classList.remove('hidden');
    okBtn.onclick = hideModal;
    okBtn.focus();
  };

  window.appConfirm = function(message, onConfirm) {
    msgEl.textContent = message;
    showModal();
    cancelBtn.classList.remove('hidden');
    confirmBtn.classList.remove('hidden');
    cancelBtn.onclick = hideModal;
    confirmBtn.onclick = () => { hideModal(); onConfirm(); };
    confirmBtn.focus();
  };

  // Close on backdrop click
  modal.addEventListener('click', (e) => { if (e.target === modal) hideModal(); });

  // CSRF protection — stamp X-CSRF-Token on every state-changing fetch.
  // The csrf_token cookie is JS-readable (no HttpOnly) so we can read it.
  function readCsrfCookie() {
    const m = document.cookie.match(/(?:^|;\\s*)csrf_token=([^;]+)/);
    return m ? m[1] : null;
  }
  const originalFetch = window.fetch.bind(window);
  window.fetch = (input, init = {}) => {
    const method = (init.method ?? (input instanceof Request ? input.method : 'GET')).toUpperCase();
    if (['POST', 'PUT', 'PATCH', 'DELETE'].includes(method)) {
      const headers = new Headers(init.headers ?? (input instanceof Request ? input.headers : undefined));
      if (!headers.has('X-CSRF-Token')) {
        const token = readCsrfCookie();
        if (token) headers.set('X-CSRF-Token', token);
      }
      init = { ...init, credentials: init.credentials ?? 'same-origin', headers };
    }
    return originalFetch(input, init);
  };

  // Inline event handlers (onclick="...") are blocked by CSP, so route every
  // global click through this delegator. Pages & components opt in by
  // emitting elements with [data-action="..."]; see LanguageSwitcher and
  // event/list for examples.
  document.body.addEventListener('click', (e) => {
    const target = e.target instanceof Element ? e.target.closest('[data-action]') : null;
    if (!target) return;
    const action = target.getAttribute('data-action');
    if (action === 'set-lang') {
      const lang = target.getAttribute('data-lang');
      if (lang === 'sv' || lang === 'en') {
        document.cookie = 'lang=' + lang + ';path=/;max-age=31536000';
        location.reload();
      }
    } else if (action === 'open-event') {
      const id = target.getAttribute('data-event-id');
      if (id) window.location.href = '/event/' + id;
    }
  });
})();`;

Astro.csp?.insertScriptHash(sha256ScriptHash(layoutScript));
---

<!doctype html>
<html lang={lang} class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t('site.subtitle')} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{siteTitle}</title>
  </head>
  <body class="min-h-full bg-gray-50 text-gray-900 dark:bg-gray-950 dark:text-gray-100 flex flex-col">
    <NavBar user={user} lang={lang} t={t} currentPath={Astro.url.pathname} />
    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
      <slot />
    </main>
    <footer class="bg-white dark:bg-gray-900 border-t border-gray-200 dark:border-gray-800 mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-3 text-sm">
        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3">
          <p class="text-gray-500 dark:text-gray-400">
            {t('site.title')} &mdash; {t('site.subtitle')}
          </p>
          <p class="text-gray-400 dark:text-gray-500 flex items-center justify-center sm:justify-end gap-3">
            <span>&copy; {new Date().getFullYear()}</span>
            <a
              href="/privacy"
              class="hover:text-gray-700 dark:hover:text-gray-200 underline-offset-2 hover:underline"
            >
              {t('site.privacy')}
            </a>
          </p>
        </div>
        <p class="text-center text-xs text-gray-400 dark:text-gray-500">
          {t('site.credit')}
        </p>
      </div>
    </footer>

    <!-- App Modal (shared alert/confirm) -->
    <div id="app-modal" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-black/50" role="dialog" aria-modal="true">
      <div class="bg-white dark:bg-gray-900 rounded-lg w-full max-w-sm shadow-xl mx-4 overflow-hidden">
        <div class="p-5">
          <p id="app-modal-message" class="text-sm text-gray-800 dark:text-gray-200"></p>
        </div>
        <div class="flex justify-end gap-2 px-5 py-3 bg-gray-50 dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700">
          <button id="app-modal-cancel" class="hidden px-4 py-2 text-sm font-medium rounded-md border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
            {modalCancel}
          </button>
          <button id="app-modal-confirm" class="hidden px-4 py-2 text-sm font-medium rounded-md bg-blue-600 text-white hover:bg-blue-700 transition-colors">
            {modalConfirm}
          </button>
          <button id="app-modal-ok" class="hidden px-4 py-2 text-sm font-medium rounded-md bg-blue-600 text-white hover:bg-blue-700 transition-colors">
            {modalOk}
          </button>
        </div>
      </div>
    </div>

    <script is:inline set:html={layoutScript}></script>
  </body>
</html>
