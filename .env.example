DATABASE_URL=postgresql://user:pass@localhost:5432/karen
# Optional: explicitly enable or disable TLS for the Postgres connection.
# Default: required in production, disabled in dev. Including
# `?sslmode=require` in DATABASE_URL also enables it.
# DATABASE_SSL=require
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@karen.se
BASE_URL=http://localhost:4321
SESSION_MAX_AGE_MS=2592000000
DEFAULT_MAX_GUESTS=35
DEFAULT_MAX_GUESTS_PER_USER=3
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
UPLOAD_DIR=./uploads
# Required when running `bun src/db/seed.ts` to seed the admin account.
# Generate with: openssl rand -base64 24
ADMIN_PASSWORD=
# Required when running `bun src/db/seed.ts` to seed the superadmin
# account (after the superadmin tier feature). Generate the same way.
SUPERADMIN_PASSWORD=